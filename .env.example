# Copy to .env and fill in. Real environment variables override this file.

# --- Telegram (required) ---------------------------------------------------
FL_BOT_TOKEN=
# Leave empty to bind the first chat that sends /start.
FL_CHAT_ID=

# --- Freelancer.com session (required for scanning and bidding) -------------
FL_USER_ID=40891893
FL_USERNAME=aryanhz
# Path to the cookie file; defaults to secrets/cookies.txt
# FL_COOKIES=

# --- AI endpoint -----------------------------------------------------------
# Base URL, key and model are also editable at runtime with /ai in Telegram,
# which is what the bot actually uses once you have set them there.
FL_AI_BASE=https://ai.metft.ir/v1
FL_AI_KEY=
FL_AI_MODEL=glm-5.3-flash

# --- Scan filters ----------------------------------------------------------
FL_BUDGET_MIN=10
FL_BUDGET_MAX=800
FL_MAX_BIDS=60
FL_SHORTLIST=3
# Minutes between background scans. 0 = only /scan.
FL_INTERVAL=30

# --- Bid defaults ----------------------------------------------------------
FL_PERIOD=7
FL_MILESTONE=100
